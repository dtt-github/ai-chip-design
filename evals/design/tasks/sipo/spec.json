{
  "version": 1,
  "intent": "A serial-in, parallel-out shift register. Module `sipo` with inputs clk, rst_n (active-low reset), din and shift, and an 8-bit output q. At each rising clock edge where shift is 1, q shifts left by one and din enters at bit 0 (so the first bit shifted in ends up as the most significant after 8 shifts). With shift 0, q holds. Reset clears q.",
  "top": "sipo",
  "clock": {
    "port": "clk",
    "mhz": 50
  },
  "reset": {
    "port": "rst_n",
    "active_low": true
  },
  "ports": [
    {
      "name": "clk",
      "dir": "in",
      "width": 1,
      "meaning": "Clock"
    },
    {
      "name": "rst_n",
      "dir": "in",
      "width": 1,
      "meaning": "Reset, active low: 0 resets"
    },
    {
      "name": "din",
      "dir": "in",
      "width": 1,
      "meaning": "Serial data"
    },
    {
      "name": "shift",
      "dir": "in",
      "width": 1,
      "meaning": "1 shifts din in"
    },
    {
      "name": "q",
      "dir": "out",
      "width": 8,
      "meaning": "Parallel data"
    }
  ],
  "params": [],
  "decisions": [],
  "questions": [],
  "examples": [
