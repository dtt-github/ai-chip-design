{
  "version": 1,
  "intent": "A Gray-code counter. Module `gray4` with inputs clk, rst_n (active-low reset) and en, and a 4-bit output gray. At each rising clock edge where en is 1 it moves to the next value of the 4-bit reflected binary Gray code (0, 1, 3, 2, 6, 7, 5, 4, 12, 13, 15, 14, 10, 11, 9, 8, then back to 0). With en 0 it holds. Reset sets it to 0.",
  "top": "gray4",
  "clock": {
    "port": "clk",
    "mhz": 50
  },
  "reset": {
    "port": "rst_n",
    "active_low": true
  },
  "ports": [
    {
      "name": "clk",
      "dir": "in",
      "width": 1,
      "meaning": "Clock"
    },
    {
      "name": "rst_n",
      "dir": "in",
      "width": 1,
      "meaning": "Reset, active low: 0 resets"
    },
    {
      "name": "en",
      "dir": "in",
      "width": 1,
      "meaning": "1 advances the counter"
    },
    {
      "name": "gray",
      "dir": "out",
      "width": 4,
      "meaning": "Gray-code value"
    }
  ],
  "params": [],
  "decisions": [],
  "questions": [],
  "examples": [
    {
      "id": "sequence",
      "title": "Steps through the Gray code",
      "given": "",
      "expect": "",
      "params": [],
      "steps": [
        {
          "op": "set",
          "signal": "en",
          "value": "1"
        },
        {
          "op": "expect",
          "signal": "gray",
          "value": "0"
        },
        {
          "op": "wait",
          "cycles": 1
        },
        {
          "op": "expect",
          "signal": "gray",
          "value": "1"
        },
        {
          "op": "wait",
          "cycles": 1
        },
        {
          "op": "expect",
          "signal": "gray",
          "value": "3"
        },
        {
          "op": "wait",
          "cycles": 1
        },
        {
          "op": "expect",
          "signal": "gray",
          "value": "2"
        },
        {
          "op": "wait",
          "cycles": 1
        },
        {
          "op": "expect",
          "signal": "gray",
          "value": "6"
        }
      ]
    },
    {
      "id": "hold",
      "title": "en 0 holds the value",
      "given": "",
      "expect": "",
      "params": [],
      "steps": [
        {
          "op": "set",
          "signal": "en",
          "value": "1"
        },
        {
          "op": "wait",
          "cycles": 3
        },
        {
          "op": "set",
          "signal": "en",
          "value": "0"
        },
        {
          "op": "expect_for",
          "signal": "gray",
          "value": "2",
          "cycles": 5
        }
      ]
    },
    {
      "id": "wrap",
      "title": "After 8 comes 0",
      "given": "",
      "expect": "",
      "params": [],
      "steps": [
        {
          "op": "set",
          "signal": "en",
          "value": "1"
        },
        {
          "op": "wait",
          "cycles": 15
        },
        {
          "op": "expect",
          "signal": "gray",
          "value": "8"
        },
        {
          "op": "wait",
          "cycles": 1
        },
        {
          "op": "expect",
          "signal": "gray",
          "value": "0"
        }
      ]
    }
  ]
}
