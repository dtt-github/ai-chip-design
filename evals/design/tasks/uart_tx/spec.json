        {
          "op": "set",
          "signal": "start",
          "value": "1"
        },
        {
          "op": "wait",
          "cycles": 1
        },
        {
          "op": "set",
          "signal": "start",
          "value": "0"
        },
        {
          "op": "wait_until",
          "signal": "busy",
          "value": "0",
          "cycles": 40
        },
        {
