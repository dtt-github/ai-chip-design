# syntax=docker/dockerfile:1
# The API server, with the Verible language server and the Docker CLI it uses to start flow runs.
# Build from the repository root: docker build -f deploy/pilot/Dockerfile.api .

FROM rust:1.99.1-slim-trixie AS build
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config cmake make g++ curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates crates
# The starter designs are built into the API (crates/wafer-api/build.rs).
COPY evals/design/tasks evals/design/tasks
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/target \
    cargo build --release --locked -p wafer-api && cp target/release/wafersmith-api /wafersmith-api
COPY scripts/fetch-verible.sh scripts/fetch-verible.sh
RUN bash scripts/fetch-verible.sh && cp -r .tools/verible /verible && chmod -R a+rX /verible

FROM docker:27-cli AS dockercli

FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin wafer
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=build /wafersmith-api /usr/local/bin/wafersmith-api
COPY --from=build /verible /opt/verible
ENV WAFER_BIND=0.0.0.0:8090 \
    WAFER_VERIBLE_LS=/opt/verible/bin/verible-verilog-ls \
    RUST_LOG=info
USER 10001
EXPOSE 8090
ENTRYPOINT ["/usr/local/bin/wafersmith-api"]
