# Copy to .env for local development (cargo run -p sc-api).
SC_BIND=127.0.0.1:8090
DATABASE_URL=postgres://sc:sc@127.0.0.1:5442/siliconcommons
SC_DATA_DIR=./data
SC_OIDC_ISSUER=http://localhost:8180/auth/v1/
SC_OIDC_AUDIENCES=siliconcommons-web,siliconcommons-dev-cli
RUST_LOG=info,sc_api=debug,tower_http=info
