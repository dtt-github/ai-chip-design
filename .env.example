# Copy to .env for local development (cargo run -p sc-api).
SC_BIND=127.0.0.1:8090
DATABASE_URL=postgres://sc:sc@127.0.0.1:5442/siliconcommons
SC_DATA_DIR=./data
SC_OIDC_ISSUER=http://localhost:8180/auth/v1/
SC_OIDC_AUDIENCES=siliconcommons-web,siliconcommons-dev-cli
RUST_LOG=info,sc_api=debug,tower_http=info
# Verilog language server (installed by scripts/fetch-verible.sh)
SC_VERIBLE_LS=.tools/verible/bin/verible-verilog-ls
SC_LSP_MAX_SESSIONS=32
# Flow runs (LibreLane in Docker); see scripts/fetch-pdk.sh
SC_LIBRELANE_IMAGE=ghcr.io/librelane/librelane:3.0.16
SC_PDK_VOLUME=siliconcommons_pdk
SC_JOB_WORKERS=2
SC_JOB_CPUS=4
SC_JOB_MEMORY=8g
