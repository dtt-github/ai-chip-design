# Copy to .env for local development (cargo run -p wafer-api).
WAFER_BIND=127.0.0.1:8090
DATABASE_URL=postgres://wafer:wafer@127.0.0.1:5442/wafersmith
WAFER_DATA_DIR=./data
WAFER_OIDC_ISSUER=http://localhost:8180/auth/v1/
WAFER_OIDC_AUDIENCES=wafersmith-web,wafersmith-dev-cli
RUST_LOG=info,wafer_api=debug,tower_http=info
# Verilog language server (installed by scripts/fetch-verible.sh)
WAFER_VERIBLE_LS=.tools/verible/bin/verible-verilog-ls
WAFER_LSP_MAX_SESSIONS=32
# Flow runs (LibreLane in Docker); see scripts/fetch-pdk.sh
WAFER_LIBRELANE_IMAGE=ghcr.io/librelane/librelane:3.0.16
WAFER_PDK_VOLUME=wafersmith_pdk
WAFER_JOB_WORKERS=2
WAFER_JOB_CPUS=4
WAFER_JOB_MEMORY=8g
# AI agent (Claude Messages API). Without a key the agent is disabled.
# Either an Anthropic key, or an OpenRouter key (uses OpenRouter's Anthropic-compatible endpoint).
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# WAFER_AGENT_MODEL=claude-opus-5-5
# WAFER_AGENT_EFFORT=high
